---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFloat from '../components/WaFloat.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import { site, postalAddress, sameAs } from '../data/site';
import { m } from '../lib/url';
import { LANGS, langFromUrl, langMeta, alternates, useT } from '../i18n';

interface Props {
  title: string;
  description: string;
  pageName?: string; // shown on the page-transition curtain
  image?: string; // /media/... file for social sharing
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, pageName, image = 'og.jpg', schema = [], noindex = false } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const alt = alternates(Astro.url);
// Odia and Hindi pages also load a Noto font for their script (English pages load exactly what they did before).
const scriptFont = lang === 'or' ? '&family=Noto+Sans+Oriya:wght@400;500;600;700' : lang === 'hi' ? '&family=Noto+Sans+Devanagari:wght@400;500;600;700' : '';
const fonts = `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500${scriptFont}&display=swap`;
const sfx = lang === 'en' ? '' : `-${lang}`; // persisted header/menu are per language
const fullTitle = title.includes('SINTEL') || title.includes('|') ? title : `${title} | SINTEL Enterprises`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(m(image), Astro.site);
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  logo: new URL(m('og.jpg'), Astro.site).href,
  telephone: site.landlineHref,
  ...(site.email ? { email: site.email } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  address: postalAddress,
  subOrganization: [{ '@type': 'FinancialService', name: site.finserv }, { '@type': 'RealEstateAgent', name: site.venture }],
};
---
<!doctype html>
<html lang={langMeta[lang].html} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alt.localized && LANGS.map((l) => <link rel="alternate" hreflang={langMeta[l].html} href={new URL(alt.href[l], Astro.site)} />)}
    {alt.localized && <link rel="alternate" hreflang="x-default" href={new URL(alt.href.en, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#073B2B" />
    <link rel="icon" href={m('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SINTEL Enterprises" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fonts} />
    <link href={fonts} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={fonts} rel="stylesheet" /></noscript>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try { if (sessionStorage.getItem('sintel-seen')) d.classList.add('seen'); } catch (e) {}
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var c = navigator.connection; var slow = c && (c.saveData || /2g/.test(c.effectiveType || ''));
        if (rm || slow) d.classList.add('no-motion', 'seen');
        // Phones skip the loading screen: the page shows straight away (faster first paint on mobile).
        if (window.matchMedia('(max-width: 900px)').matches) d.classList.add('seen', 'phone');
        if (c && /3g/.test(c.effectiveType || '')) d.classList.add('lite');
        if (!window.__sintelGuard) {
          window.__sintelGuard = true;
          // If the main script never starts (blocked, offline, cache mismatch), show the site
          // plainly after 4 s instead of leaving the loader up. Once it is running, only "seen" is ensured.
          setTimeout(function () {
            if (!window.__sintelReady) d.classList.add('seen', 'js-off');
          }, 4000);
          setTimeout(function () {
            d.classList.add('seen');
            try { sessionStorage.setItem('sintel-seen', '1'); } catch (e) {}
          }, 6000);
        }
      })();
    </script>
    {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
    {site.gaId && <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
      <script is:inline define:vars={{ gaId: site.gaId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>}
    <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">{t.common.skip}</a>

    <div class="preloader" id="preloader" aria-hidden="true" transition:persist={`preloader${sfx}`}>
      <Mark class="mark" />
      <span class="cap">{t.common.preloader}</span>
      <span class="count" id="pl-count">00</span>
      <span class="bar" id="pl-bar"></span>
    </div>

    <div class="curtain" id="curtain" aria-hidden="true" transition:persist="curtain">
      <div class="in"><Mark /><span class="pn" id="curtain-name"></span></div>
    </div>

    <Header />

    <main id="main" data-page-name={pageName ?? title}>
      <slot />
    </main>

    <Footer />

    <WaFloat />
    <button class="to-top" type="button" aria-label={t.common.backToTop} transition:persist={`totop${sfx}`}><Icon name="up" class="chev" /></button>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
