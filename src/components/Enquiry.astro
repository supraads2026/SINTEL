---
import Icon from './Icon.astro';
import { site, telHref } from '../data/site';
import { loans } from '../data/loans';
import { propertyTypes } from '../data/property';
import { m } from '../lib/url';
import { langFromUrl, langMeta, useT } from '../i18n';
import { loansFor, propertyTypesFor } from '../i18n/data';
const lang = langFromUrl(Astro.url);
const t = useT(lang);
interface Props {
  title?: [string, string];
  text?: string;
  interest?: 'finserv' | 'venture';
  need?: string; // pre-selected loan or property need
  bg?: 'green' | 'dark';
  img?: string;
  id?: string;
}
const {
  title = t.enquiry.h,
  text = t.enquiry.text,
  interest = '',
  need = '',
  bg = 'green',
  img,
  id = 'enquire',
} = Astro.props;
const loansL = loansFor(lang);
const typesL = propertyTypesFor(lang);
const needs = [
  ...loans.map((l, i) => ({ v: l.name, label: loansL[i].name, g: 'finserv' })),
  ...propertyTypes.map((p, i) => ({ v: `Buy: ${p.name}`, label: t.enquiry.buy(typesL[i].name), g: 'venture' })),
  { v: 'Sell my property', label: t.enquiry.sellMine, g: 'venture' },
];

---
<section class:list={['section', bg === 'green' ? 'green' : 'dark']} id={id}>
  <div class="wrap enquiry">
    <div>
      <p class="eyebrow">{t.common.enquire}</p>
      <h2><span class="line"><span>{title[0]}</span></span><span class="line"><span><em>{title[1]}</em></span></span></h2>
      <p class="lead mt-2" style="color:rgba(252,251,246,.92)">{text}</p>
      <div class="btns mt-2">
        {interest !== 'venture' && <a class="btn" href={telHref(site.finservPhone)}><Icon name="phone" class="chev" /> {interest ? '' : t.enquiry.finservPrefix}{site.finservPhone}</a>}
        {interest !== 'finserv' && <a class="btn" href={telHref(site.venturePhone)}><Icon name="phone" class="chev" /> {interest ? '' : t.enquiry.venturePrefix}{site.venturePhone}</a>}
      </div>
      {img && <img src={m(`img/${img}-sm.webp`)} alt="" loading="lazy" width="720" height="402" style="margin-top:2.5rem;border-radius:20px;opacity:.95" data-parallax />}
    </div>
    <form class="form" data-enquiry novalidate data-wa-finserv={site.finservWa} data-wa-venture={site.ventureWa} data-email={site.email}>
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value="New website enquiry — SINTEL" />
      <input type="hidden" name="page" value={Astro.url.pathname} />
      {lang !== 'en' && <input type="hidden" name="language" value={langMeta[lang].wa} />}
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label={t.enquiry.botcheck} />
      <div class="field"><label for={`${id}-name`}>{t.enquiry.name}</label><input id={`${id}-name`} name="name" required autocomplete="name" placeholder={t.enquiry.namePh} /></div>
      <div class="field"><label for={`${id}-mobile`}>{t.enquiry.mobile}</label><input id={`${id}-mobile`} name="mobile" required type="tel" inputmode="tel" autocomplete="tel" placeholder={t.enquiry.mobilePh} pattern="[0-9+ ]{10,15}" title={t.enquiry.mobileTitle} /></div>
      <div class="field"><label for={`${id}-int`}>{t.enquiry.interested}</label>
        <select id={`${id}-int`} name="interested_in" required>
          <option value="" disabled selected={!interest}>{t.enquiry.choose}</option>
          <option value="Dwarika Finserv (loans)" selected={interest === 'finserv'}>{t.enquiry.optFinserv}</option>
          <option value="Dwarika Venture (property)" selected={interest === 'venture'}>{t.enquiry.optVenture}</option>
        </select>
      </div>
      <div class="field"><label for={`${id}-need`}>{t.enquiry.need}</label>
        <select id={`${id}-need`} name="need">
          <option value="" selected={!need}>{t.enquiry.notSure}</option>
          <optgroup label="Dwarika Finserv">{needs.filter((n) => n.g === 'finserv').map((n) => (n.label === n.v ? <option selected={need === n.v}>{n.v}</option> : <option value={n.v} selected={need === n.v}>{n.label}</option>))}</optgroup>
          <optgroup label="Dwarika Venture">{needs.filter((n) => n.g === 'venture').map((n) => (n.label === n.v ? <option selected={need === n.v}>{n.v}</option> : <option value={n.v} selected={need === n.v}>{n.label}</option>))}</optgroup>
          {need && !needs.some((n) => n.v === need) && <option selected>{need}</option>}
        </select>
      </div>
      <div class="field full"><label for={`${id}-msg`}>{t.enquiry.message}</label><textarea id={`${id}-msg`} name="message" rows="4" placeholder={t.enquiry.messagePh}></textarea></div>
      <label class="consent full"><input type="checkbox" name="consent" required /> <span>{t.enquiry.consent}</span></label>
      <div class="btns full">
        <button class="btn btn-gold magnetic" type="submit">{t.enquiry.send} <Icon name="arrow" class="chev arr" /></button>
        <button class="btn" type="button" data-wa-send><Icon name="wa" class="chev" /> {t.common.chatWa}</button>
      </div>
      <p class="form-status full" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
