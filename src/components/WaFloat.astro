---
// Floating WhatsApp button. On Finserv / Venture pages it goes straight to that company's number;
// on shared pages (Home, About, Contact…) it opens a small "which company?" chooser.
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
import { langFromUrl, useT } from '../i18n';
const t = useT(langFromUrl(Astro.url));
const path = Astro.url.pathname;
const co = path.includes('/dwarika-finserv') ? 'finserv' : path.includes('/dwarika-venture') ? 'venture' : null;
---
{co ? (
  <a class="wa-float" href={waLink(t.wa.more(co === 'finserv' ? site.finserv : site.venture), co)} target="_blank" rel="noopener" aria-label={t.wa.chatWith(co === 'finserv' ? site.finserv : site.venture)}><Icon name="wa" /></a>
) : (
  <details class="wa-pick">
    <summary class="wa-float" aria-label={t.common.chatWa}><Icon name="wa" /></summary>
    <div class="wa-menu" role="menu">
      <p>{t.wa.pickTitle}</p>
      <a role="menuitem" href={waLink(t.common.waLoan(site.finserv), 'finserv')} target="_blank" rel="noopener"><b>{site.finserv}</b><span>{t.wa.loans} · {site.finservPhone}</span></a>
      <a role="menuitem" href={waLink(t.common.waProperty(site.venture), 'venture')} target="_blank" rel="noopener"><b>{site.venture}</b><span>{t.wa.property} · {site.venturePhone}</span></a>
    </div>
  </details>
)}
