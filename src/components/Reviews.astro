---
// Customer reviews + Google rating link. Renders nothing until SINTEL adds real reviews or its Google link
// (src/data/site.ts → reviews, googleReviewsUrl, googleRating, googleReviewCount).
import Icon from './Icon.astro';
import { site, reviews } from '../data/site';
import { langFromUrl, useT } from '../i18n';
const t = useT(langFromUrl(Astro.url));
interface Props { bg?: 'ivory' | 'dark' }
const { bg = 'ivory' } = Astro.props;
const show = reviews.length > 0 || !!site.googleReviewsUrl;
const stars = (n = 5) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n));
---
{show && (
  <section class:list={['section', bg === 'dark' ? 'dark' : 'ivory', 'reviews']}>
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{t.reviews.eyebrow}</p><h2 data-split>{t.reviews.h[0]} <em>{t.reviews.h[1]}</em></h2></div>
      {site.googleReviewsUrl && (
        <a class="g-rating" href={site.googleReviewsUrl} target="_blank" rel="noopener" data-track="google_reviews">
          {site.googleRating && <b>{site.googleRating}</b>}
          {site.googleRating && <span class="stars" aria-hidden="true">{stars(Number(site.googleRating))}</span>}
          <span>{site.googleReviewCount ? t.reviews.count(site.googleReviewCount) : t.reviews.readGoogle}</span>
          <Icon name="arrow" class="chev arr" />
        </a>
      )}
      {reviews.length > 0 && (
        <div class="cards mt-3">
          {reviews.map((r) => (
            <figure class="card review" data-reveal>
              <span class="stars" aria-label={t.reviews.outOf5(r.rating ?? 5)}>{stars(r.rating)}</span>
              <blockquote>{r.text}</blockquote>
              <figcaption><b>{r.name}</b>{r.about && <span class="muted"> · {r.about}</span>}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}
