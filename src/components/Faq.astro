---
import { fmt, isTodoOnly, SHOW_TODOS } from '../lib/text';
interface Props { faqs: { q: string; a: string }[] }
const faqs = Astro.props.faqs.filter((f) => SHOW_TODOS || !isTodoOnly(f.a));
---
<div class="faq">
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div class="ans"><p set:html={fmt(f.a)} /></div>
    </details>
  ))}
</div>
