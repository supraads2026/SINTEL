---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';
import { loans } from '../data/loans';
import { propertyTypes } from '../data/property';
import { site, telHref, waLink } from '../data/site';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v);
const iconFor: Record<string, string> = { instagram: 'ig', facebook: 'fb', linkedin: 'in', x: 'x' };
---
<footer class="site-footer">
  <div class="wrap">
    <p class="f-big"><a href={u('/contact/#enquire')}>Let's build <em>what's next.</em></a></p>
    <div class="f-grid">
      <div>
        <a class="brand" href={u('/')} aria-label="SINTEL Enterprises home"><Mark /><span><span class="brand-word">SINTEL</span><span class="brand-sub">ENTERPRISES</span></span></a>
        <p style="margin-top:22px">{site.addressLines.map((l) => <>{l}<br /></>)}{site.hours}</p>
        <p>Office: <a href={telHref(site.landlineHref)}>{site.landline}</a><br />{site.finserv}: <a href={telHref(site.finservPhone)}>{site.finservPhone}</a><br />{site.venture}: <a href={telHref(site.venturePhone)}>{site.venturePhone}</a>{site.email && <><br /><a href={`mailto:${site.email}`}>{site.email}</a></>}</p>
        {socials.length > 0 && <div class="socials">{socials.map(([k, v]) => <a href={v} target="_blank" rel="noopener" aria-label={k}><Icon name={iconFor[k]} class="chev" /></a>)}</div>}
      </div>
      <div>
        <h2 class="f-h">Dwarika Finserv</h2>
        <ul>{loans.map((l) => <li><a href={u(`/dwarika-finserv/${l.slug}/`)}>{l.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="f-h">Dwarika Venture</h2>
        <ul>
          {propertyTypes.map((t) => <li><a href={u(`/dwarika-venture/${t.slug}/`)}>{t.name}</a></li>)}
          <li><a href={u('/dwarika-venture/sell-your-property/')}>Sell Your Property</a></li>
          <li><a href={u('/dwarika-venture/buyers-guide/')}>Buyer's Guide</a></li>
        </ul>
      </div>
      <div>
        <h2 class="f-h">SINTEL</h2>
        <ul>
          <li><a href={u('/about/')}>About</a></li>
          <li><a href={u('/contact/')}>Contact</a></li>
          <li><a href={waLink(`Hi ${site.finserv}, I would like to know about a loan.`, 'finserv')} target="_blank" rel="noopener">WhatsApp Finserv</a></li>
          <li><a href={waLink(`Hi ${site.venture}, I would like to know about a property.`, 'venture')} target="_blank" rel="noopener">WhatsApp Venture</a></li>
        </ul>
      </div>
    </div>
    <div class="f-bottom">
      <span>© {year} {site.legalName}. All rights reserved.{site.oreraAgent && <> · {site.venture}: ORERA Reg. No. {site.oreraAgent}</>}{site.cin && <> · CIN {site.cin}</>}</span>
      <span><a href={u('/disclaimer/')}>Disclaimer</a> · <a href={u('/privacy-policy/')}>Privacy</a></span>
    </div>
  </div>
</footer>
