---
interface Props { kind?: 'finserv' | 'venture' }
const { kind = 'finserv' } = Astro.props;
---
<div class="disclaimer"><div class="wrap">
  {kind === 'finserv'
    ? <p>Dwarika Finserv helps you find suitable loan options. Approval, interest rates and terms are decided by the lending bank or NBFC.</p>
    : <p>Dwarika Venture helps you find and buy property. Please verify all documents and ORERA details before any payment; prices and availability can change.</p>}
</div></div>
