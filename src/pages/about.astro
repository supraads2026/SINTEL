---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Enquiry from '../components/Enquiry.astro';
import { m, u } from '../lib/url';
import { site } from '../data/site';
const values = [
  { icon: 'shield', t: 'Trust', d: 'We earn it slowly and protect it carefully.' },
  { icon: 'eye', t: 'Transparency', d: 'Clear options, clear costs, no surprises.' },
  { icon: 'compass', t: 'Guidance', d: 'Plain-language advice at every step.' },
  { icon: 'growth', t: 'Growth', d: 'For the families and businesses we serve.' },
];
---
<Base title="About SINTEL Enterprises | Bhubaneswar" description="SINTEL Enterprises is a Bhubaneswar group bringing loans (Dwarika Finserv) and property (Dwarika Venture) together under one trusted name." pageName="About SINTEL">
  <!-- Tower turns as you scroll (VID-04 scrubbed by scroll position) -->
  <section class="tower-scrub" data-scrub aria-label="About SINTEL">
    <div class="pin">
      <video muted playsinline preload="none" aria-hidden="true"><source src={m('video/vid-04-about-tower-orbit-scrub.mp4')} type="video/mp4" /></video>
      <img src={m('img/img-04-about-orbit-poster.webp')} alt="The SINTEL towers on a marble podium" width="1280" height="720" fetchpriority="high" />
      <div class="copy"><div class="wrap">
        <p class="eyebrow" data-hero-in>About SINTEL</p>
        <h1 class="hero-h1"><span class="line"><span>About SINTEL.</span></span><span class="line"><span><em>Building opportunities.</em></span></span></h1>
      </div></div>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 data-split>Rooted in <em>Bhubaneswar.</em></h2>
      </div>
      <div class="lead">
        <p><mark class="todo">To confirm: 2–3 paragraphs from SINTEL — when the group started, why, and who it serves.</mark></p>
        <p>{site.legalName} brings two specialist companies under one roof: {site.finserv}, which helps people and businesses find the right loan, and {site.venture}, which helps them buy and sell property. From our office on Lewis Road, we work with families and businesses across Bhubaneswar and Odisha.</p>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="two-col">
        <div data-reveal><p class="eyebrow">Vision</p><p class="statement" style="font-size:clamp(1.6rem,3vw,2.6rem)">To be Odisha's most trusted name in <strong>finance and property.</strong></p></div>
        <div data-reveal><p class="eyebrow">Mission</p><p class="statement" style="font-size:clamp(1.6rem,3vw,2.6rem)">Clear, honest guidance for every <strong>loan</strong> and every <strong>property decision.</strong></p></div>
      </div>
      <p class="mt-3"><mark class="todo">To confirm: vision and mission wording</mark></p>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap two-col" style="align-items:center">
      <div class="art" data-reveal style="aspect-ratio:4/5;border-radius:26px;overflow:hidden;background:var(--forest);display:grid;place-items:center;color:var(--gold);max-width:440px">
        <!-- TODO(SINTEL): replace with the photo of Ashok Kumar Sahoo (public/media/img/ashok-kumar-sahoo.webp) -->
        <div style="text-align:center;padding:30px"><Icon name="eye" class="icon" /><p style="margin-top:14px;color:var(--muted-dk)">Leadership photo<br />coming soon</p></div>
      </div>
      <div>
        <p class="eyebrow">Leadership</p>
        <h2 data-split>{site.founder}</h2>
        <p class="lead muted mt-2">{site.founderRole} <mark class="todo">To confirm</mark></p>
        <p class="muted"><mark class="todo">To confirm: a short note from {site.founder}.</mark></p>
      </div>
    </div>
  </section>

  <section class="section dark deep">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">The group</p><h2 data-split>One group, <em>two companies.</em></h2></div>
      <div class="org" data-reveal>
        <div class="top"><b>SINTEL</b><span class="muted" style="font-size:.8rem;letter-spacing:.24em">ENTERPRISES</span></div>
        <div class="stem"></div>
        <div class="arm"></div>
        <div class="kids">
          <a class="kid" href={u('/dwarika-finserv/')}><b>Dwarika Finserv</b><span>Loans and funding, from personal needs to big projects.</span></a>
          <a class="kid" href={u('/dwarika-venture/')}><b>Dwarika Venture</b><span>Homes, plots and commercial property for sale.</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Our values</p><h2 data-split>What we <em>stand for.</em></h2></div>
      <div class="cards">{values.map((v) => <div class="card" data-reveal><span class="icon"><Icon name={v.icon} /></span><h3>{v.t}</h3><p>{v.d}</p></div>)}</div>
    </div>
  </section>

  <Enquiry title={["Let's", 'talk.']} />
</Base>
