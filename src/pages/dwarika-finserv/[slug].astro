---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Enquiry from '../../components/Enquiry.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { loans, type Loan } from '../../data/loans';
import { site, waLink } from '../../data/site';

export function getStaticPaths() {
  return loans.map((l) => ({ params: { slug: l.slug }, props: { loan: l } }));
}
const { loan } = Astro.props as { loan: Loan };
const i = loans.indexOf(loan);
const related = [1, 2, 3].map((k) => loans[(i + k) % loans.length]);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `${loan.name} in Bhubaneswar`, serviceType: 'Loan advisory', provider: { '@type': 'FinancialService', name: site.finserv }, areaServed: 'Bhubaneswar, Odisha', description: loan.oneLiner },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: loan.faqs.filter((f) => !f.a.includes('TODO')).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={`${loan.name} in Bhubaneswar | Dwarika Finserv`} description={loan.description} pageName={loan.name} image={`img/${loan.img}.webp`} schema={schema}>
  <PageHero eyebrow="Dwarika Finserv" h1={loan.h1} lead={loan.oneLiner} img={loan.img} crumbs={[{ href: '/dwarika-finserv/', name: 'Dwarika Finserv' }]}>
    <div class="btns">
      <a class="btn btn-gold magnetic" href="#enquire">Enquire about this loan <Icon name="arrow" class="chev arr" /></a>
      <a class="btn" href={waLink(`Hi Dwarika Finserv, I'd like to know about a ${loan.name}.`, 'finserv')} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> WhatsApp</a>
    </div>
  </PageHero>

  <section class="section ivory">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Who it's for</p>
        <h2 data-split>{loan.whoFor}.</h2>
        <ul class="check-list mt-2">{loan.whoForList.map((w) => <li data-reveal>{w}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">What you can use it for</p>
        <div class="chips mt-2">{loan.uses.map((u) => <span class="chip" data-reveal>{u}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section dark" id="eligibility">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Eligibility, documents &amp; rates</p><h2 data-split>Before you <em>apply.</em></h2></div>
      <div class="loan-facts">
        <div class="lf" data-reveal>
          <h3><Icon name="shield" class="chev" /> Eligibility</h3>
          <ul class="check-list">{loan.eligibility.map((e) => <li>{e}</li>)}</ul>
          <p class="muted lf-note">Most lenders look for the above. Each lender sets its own final criteria.</p>
        </div>
        <div class="lf" data-reveal>
          <h3><Icon name="doc" class="chev" /> Documents needed</h3>
          <ul class="check-list">{loan.docs.map((d) => <li>{d}</li>)}</ul>
          <p class="muted lf-note">The final list depends on the lender.</p>
        </div>
        <div class="lf lf-rate" data-reveal>
          <h3><Icon name="growth" class="chev" /> Interest rate</h3>
          {loan.rate ? (
            <>
              <p class="rate">{loan.rate}</p>
              <p class="muted">Indicative range across our partner banks and NBFCs. Your rate depends on your income, credit score, loan amount and the lender's policy.</p>
            </>
          ) : (
            <p class="muted">Rates are set by the lending bank or NBFC and depend on your income, credit score, loan amount and tenure. We compare current rates from several lenders for you.</p>
          )}
          <a class="btn btn-gold btn-sm mt-1" href={waLink(`Hi Dwarika Finserv, what are today's interest rates for a ${loan.name}?`, 'finserv')} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> Ask for today's rates</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">How it works</p><h2 data-split>Four clear <em>steps.</em></h2></div>
      <Steps steps={[
        { t: 'Enquire', d: `Tell us about the ${loan.name.toLowerCase()} you need.` },
        { t: 'We call you', d: 'We check your eligibility and documents.' },
        { t: 'Compare options', d: 'We help you compare suitable lenders.' },
        { t: 'Processing & sanction', d: 'The lender decides; we help with the paperwork.' },
      ]} />
    </div>
  </section>

  <section class="section ivory" style="padding-top:0">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">FAQs</p><h2 data-split>{loan.name} <em>questions.</em></h2></div>
      <Faq faqs={loan.faqs} />
    </div>
  </section>

  <section class="section ivory" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Related loans</p><h2 data-split>You may <em>also need.</em></h2></div>
      <Related items={related.map((r) => ({ href: `/dwarika-finserv/${r.slug}/`, title: r.name, desc: r.oneLiner, img: r.img }))} />
    </div>
  </section>

  <Enquiry interest="finserv" need={loan.name} title={['Ask about a', `${loan.name}.`]} />
  <Disclaimer />
</Base>
