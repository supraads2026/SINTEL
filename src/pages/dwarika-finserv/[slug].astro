---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Enquiry from '../../components/Enquiry.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { loans, type Loan } from '../../data/loans';
import { site } from '../../data/site';

export function getStaticPaths() {
  return loans.map((l) => ({ params: { slug: l.slug }, props: { loan: l } }));
}
const { loan } = Astro.props as { loan: Loan };
const i = loans.indexOf(loan);
const related = [1, 2, 3].map((k) => loans[(i + k) % loans.length]);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: loan.name, serviceType: 'Loan advisory', provider: { '@type': 'FinancialService', name: site.finserv }, areaServed: 'Bhubaneswar, Odisha', description: loan.oneLiner },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: loan.faqs.filter((f) => !f.a.includes('TODO')).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={`${loan.name} in Bhubaneswar | Dwarika Finserv`} description={loan.description} pageName={loan.name} image={`img/${loan.img}.webp`} schema={schema}>
  <PageHero eyebrow="Dwarika Finserv" h1={loan.h1} lead={loan.oneLiner} img={loan.img} crumbs={[{ href: '/dwarika-finserv/', name: 'Dwarika Finserv' }]}>
    <div class="btns">
      <a class="btn btn-gold magnetic" href="#enquire">Enquire about this loan <Icon name="arrow" class="chev arr" /></a>
      <a class="btn" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi Dwarika Finserv, I'd like to know about a ${loan.name}.`)}`} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> WhatsApp</a>
    </div>
  </PageHero>

  <section class="section ivory">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Who it's for</p>
        <h2 data-split>{loan.whoFor}.</h2>
        <ul class="check-list mt-2">{loan.whoForList.map((w) => <li data-reveal>{w}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">What you can use it for</p>
        <div class="chips mt-2">{loan.uses.map((u) => <span class="chip" data-reveal>{u}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">Documents</p><h2 data-split>Usually <em>needed.</em></h2><p class="muted">The final list depends on the lender.</p></div>
      <ul class="check-list">{loan.docs.map((d) => <li data-reveal>{d}</li>)}</ul>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">How it works</p><h2 data-split>Four clear <em>steps.</em></h2></div>
      <Steps steps={[
        { t: 'Enquire', d: `Tell us about the ${loan.name.toLowerCase()} you need.` },
        { t: 'We call you', d: 'We check your eligibility and documents.' },
        { t: 'Compare options', d: 'We help you compare suitable lenders.' },
        { t: 'Processing & sanction', d: 'The lender decides; we help with the paperwork.' },
      ]} />
    </div>
  </section>

  <section class="section ivory" style="padding-top:0">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">FAQs</p><h2 data-split>{loan.name} <em>questions.</em></h2></div>
      <Faq faqs={loan.faqs} />
    </div>
  </section>

  <section class="section ivory" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Related loans</p><h2 data-split>You may <em>also need.</em></h2></div>
      <Related items={related.map((r) => ({ href: `/dwarika-finserv/${r.slug}/`, title: r.name, desc: r.oneLiner, img: r.img }))} />
    </div>
  </section>

  <Enquiry interest="finserv" need={loan.name} title={['Ask about a', `${loan.name}.`]} />
  <Disclaimer />
</Base>
