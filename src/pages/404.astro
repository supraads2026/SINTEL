---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
---
<Base title="Page not found" description="This page could not be found." pageName="Not found" noindex>
  <section class="page-hero" style="min-height:80svh;display:flex;align-items:center">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1><span class="line"><span>This page has</span></span><span class="line"><span><em>moved on.</em></span></span></h1>
      <div class="btns mt-2"><a class="btn btn-gold" href={u('/')}>Back to home <Icon name="arrow" class="chev arr" /></a></div>
    </div>
  </section>
</Base>
