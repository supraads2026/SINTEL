---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HoverList from '../components/HoverList.astro';
import Steps from '../components/Steps.astro';
import Enquiry from '../components/Enquiry.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { u, m } from '../lib/url';
import { loans } from '../data/loans';
import { properties } from '../data/property';

const statement = 'SINTEL Enterprises brings loans and property under one trusted group in Bhubaneswar, so a family buying a home or a business planning its next step can find the funding <strong>and</strong> the property in one place.';
const why = [
  { icon: 'layers', t: 'Finance and property in one group', d: 'Find the home and the home loan, or fund the business and its premises, with one team.' },
  { icon: 'chat', t: 'Honest, plain-language guidance', d: 'We explain your options clearly, with no jargon and no pressure.' },
  { icon: 'pin', t: 'Based in Bhubaneswar', d: 'A local team on Lewis Road that knows the city and its neighbourhoods.' },
  { icon: 'phone', t: 'One call or WhatsApp away', d: 'Reach us the way that suits you, and we will call you back.' },
];
const featured = properties.slice(0, 3);

// Rotating hero: one 8-second video per slide, in story order (group → finance → bridge → property → brand).
// Every word is live HTML; the videos carry no text.
const slides = [
  { vid: 'vid-01-home-hero', w: 1920, eyebrow: 'Finance · Real Estate · Bhubaneswar', t1: 'Two companies.', t2: 'One trusted group.',
    btns: [{ t: 'Explore Dwarika Finserv', href: '/dwarika-finserv/', gold: true }, { t: 'Explore Dwarika Venture', href: '/dwarika-venture/' }] },
  { vid: 'hs-2-finserv', w: 1280, eyebrow: 'Dwarika Finserv', t1: 'Funding for', t2: 'every goal.',
    btns: [{ t: 'Explore loans', href: '/dwarika-finserv/', gold: true }, { t: 'Talk to an expert', href: '/contact/#enquire' }] },
  { vid: 'hs-5-bridge', w: 1280, eyebrow: 'SINTEL Enterprises', t1: 'Funding and property,', t2: 'connected.',
    btns: [{ t: 'Home loans', href: '/dwarika-finserv/home-loan/', gold: true }, { t: 'Find a property', href: '/dwarika-venture/' }] },
  { vid: 'hs-3-venture', w: 1280, eyebrow: 'Dwarika Venture', t1: 'Find the right', t2: 'property.',
    btns: [{ t: 'View properties', href: '/dwarika-venture/', gold: true }, { t: 'Sell your property', href: '/dwarika-venture/sell-your-property/' }] },
  { vid: 'hs-4-towers', w: 1280, eyebrow: 'SINTEL Enterprises', t1: 'Building opportunities.', t2: 'Enabling growth.',
    btns: [{ t: 'About SINTEL', href: '/about/', gold: true }, { t: 'Enquire', href: '/contact/#enquire' }] },
];
---
<Base
  title="SINTEL Enterprises | Loans & Property in Bhubaneswar"
  description="SINTEL Enterprises brings Dwarika Finserv (loans and funding) and Dwarika Venture (property sales) together under one trusted group in Bhubaneswar, Odisha."
  pageName="Home"
>
  <!-- 1 · Hero: rotating slider -->
  <section class="hero hero-home" aria-roledescription="carousel" aria-label="SINTEL Enterprises" data-hero-slider>
    <div class="hero-media">
      <div class="stage">
        {slides.map((sl, i) => (
          <div class:list={['hs-media', { 'is-active': i === 0 }]} data-i={i}>
            <img class="poster" src={m(`img/${sl.vid}-poster.webp`)} srcset={`${m(`img/${sl.vid}-poster-m.webp`)} 960w, ${m(`img/${sl.vid}-poster.webp`)} ${sl.w}w`} sizes="100vw" alt="" width={sl.w} height={sl.w * 9 / 16} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
            <video muted playsinline preload="none" aria-hidden="true" data-src={m(`video/${sl.vid}.mp4`)} data-src-m={m(`video/${sl.vid}-m.mp4`)}></video>
            {i === 0 && <>
              <a class="island-tag" href={u('/dwarika-finserv/')} style="left:17%;top:40%;--tilt:-8deg">Dwarika Finserv<span class="pulse"></span></a>
              <a class="island-tag" href={u('/dwarika-venture/')} style="left:84%;top:40%;--tilt:8deg">Dwarika Venture<span class="pulse"></span></a>
            </>}
          </div>
        ))}
      </div>
      <div class="hs-shimmer" aria-hidden="true"></div>
    </div>
    <div class="wrap hero-content">
      {slides.map((sl, i) => (
        <div class:list={['hs-copy', { 'is-active': i === 0 }]} data-i={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} inert={i !== 0}>
          <div>
            <p class="eyebrow" data-hero-in={i === 0 ? '' : undefined}>{sl.eyebrow}</p>
            {i === 0
              ? <h1><span class="line"><span>{sl.t1}</span></span> <span class="line"><span><em>{sl.t2}</em></span></span></h1>
              : <h2 class="hs-h"><span class="line"><span>{sl.t1}</span></span> <span class="line"><span><em>{sl.t2}</em></span></span></h2>}
          </div>
          <div class="btns" data-hero-in={i === 0 ? '' : undefined}>
            {sl.btns.map((bt) => (
              <a class:list={['btn', 'magnetic', { 'btn-gold': bt.gold }]} href={u(bt.href)}>{bt.t} <Icon name="arrow" class="chev arr" /></a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="hs-ctrl">
      <button class="hs-pause" type="button" aria-label="Pause slideshow" aria-pressed="false"><span></span></button>
      {slides.map((sl, i) => (
        <button class:list={['hs-dot', { 'is-active': i === 0 }]} type="button" data-go={i} aria-label={`Slide ${i + 1}: ${sl.t1} ${sl.t2}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>
      ))}
    </div>
    <div class="scroll-cue" aria-hidden="true">Scroll<i></i></div>
  </section>

  <!-- 2 · Statement -->
  <section class="section dark deep">
    <div class="dust" aria-hidden="true">
      {Array.from({ length: 22 }).map((_, i) => <i style={`left:${(i * 37) % 100}%;animation-duration:${9 + (i % 7) * 2}s;animation-delay:${(i * 1.3) % 9}s`} />)}
    </div>
    <div class="wrap">
      <p class="eyebrow">Who we are</p>
      <p class="statement" data-words set:html={statement} />
    </div>
  </section>

  <!-- 3 · Our companies -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Our companies</p>
        <h2 data-split>Two specialists, <em>one group.</em></h2>
      </div>
      <div class="co-grid">
        <a class="co-card" href={u('/dwarika-finserv/')} data-tilt data-morph data-reveal>
          <img src={m('img/img-02-finance-island.webp')} srcset={`${m('img/img-02-finance-island-m.webp')} 560w, ${m('img/img-02-finance-island.webp')} 896w`} sizes="(max-width: 760px) 92vw, 46vw" alt="Finance island: emerald bar towers, gold coins and a vault" loading="lazy" width="896" height="1200" transition:name="hero-finserv" />
          <div class="ov">
            <p class="eyebrow">Loans & funding</p>
            <h3>Dwarika Finserv</h3>
            <p>Loans and funding, from personal needs to big projects.</p>
            <span class="link-arrow">Explore <Icon name="arrow" class="chev arr" /></span>
          </div>
        </a>
        <a class="co-card" href={u('/dwarika-venture/')} data-tilt data-morph data-reveal>
          <img src={m('img/img-03-property-island.webp')} srcset={`${m('img/img-03-property-island-m.webp')} 560w, ${m('img/img-03-property-island.webp')} 896w`} sizes="(max-width: 760px) 92vw, 46vw" alt="Property island: villas, apartment blocks and green plots" loading="lazy" width="896" height="1200" transition:name="hero-venture" />
          <div class="ov">
            <p class="eyebrow">Property sales</p>
            <h3>Dwarika Venture</h3>
            <p>Homes, plots and commercial property for sale.</p>
            <span class="link-arrow">Explore <Icon name="arrow" class="chev arr" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4 · Loans list -->
  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Dwarika Finserv</p>
        <h2 data-split>Funding for <em>every goal.</em></h2>
      </div>
      <HoverList items={loans.map((l) => ({ href: `/dwarika-finserv/${l.slug}/`, title: l.name, desc: l.oneLiner, img: l.img }))} />
    </div>
  </section>

  <!-- 5 · Featured properties -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Dwarika Venture</p>
        <h2 data-split>Find the right <em>property.</em></h2>
      </div>
      <div class="prop-grid">{featured.map((p) => <PropertyCard p={p} />)}</div>
      <div class="btns mt-3"><a class="btn btn-green magnetic" href={u('/dwarika-venture/')}>View all properties <Icon name="arrow" class="chev arr" /></a></div>
    </div>
  </section>

  <!-- 6 · How it works -->
  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">How it works</p>
        <h2 data-split>Four simple <em>steps.</em></h2>
      </div>
      <Steps steps={[
        { t: 'Tell us your need', d: 'A loan, a property, or both. Call, WhatsApp or send the form.' },
        { t: 'Talk to an expert', d: 'We understand your situation and what will work for you.' },
        { t: 'Compare your options', d: 'Clear choices from lenders or listings, explained simply.' },
        { t: 'Move ahead', d: 'We stay with you through the paperwork to the finish.' },
      ]} />
    </div>
  </section>

  <!-- 7 · Why SINTEL -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Why SINTEL</p>
        <h2 data-split>Built on <em>trust.</em></h2>
      </div>
      <div class="cards">
        {why.map((w) => (
          <div class="card" data-reveal>
            <span class="icon"><Icon name={w.icon} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · Enquiry -->
  <Enquiry img="img-04-sintel-towers" />
</Base>
