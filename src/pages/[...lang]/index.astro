---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import HoverList from '../../components/HoverList.astro';
import Steps from '../../components/Steps.astro';
import Enquiry from '../../components/Enquiry.astro';
import TrackRecord from '../../components/TrackRecord.astro';
import Reviews from '../../components/Reviews.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { m } from '../../lib/url';
import { properties } from '../../data/property';
import { waLink } from '../../data/site';
import { langPaths, lp, lu, useT, type Lang } from '../../i18n';
import { loansFor } from '../../i18n/data';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const h = t.home;
const u = (p: string) => lu(lang, p);
const loans = loansFor(lang);

const statement = h.statement;
const whyIcons = ['layers', 'chat', 'pin', 'phone'];
const why = h.why.map((w, i) => ({ icon: whyIcons[i], ...w }));
const featured = properties.slice(0, 3);

// Rotating hero: one 8-second video per slide, in story order (group → finance → bridge → property → brand).
// Every word is live HTML; the videos carry no text.
const media = [
  { vid: 'vid-01-home-hero', w: 1920, hrefs: ['/dwarika-finserv/', '/dwarika-venture/'] },
  { vid: 'hs-2-finserv', w: 1280, hrefs: ['/dwarika-finserv/', '/contact/#enquire'] },
  { vid: 'hs-5-bridge', w: 1280, hrefs: ['/dwarika-finserv/home-loan/', '/dwarika-venture/'] },
  { vid: 'hs-3-venture', w: 1280, hrefs: ['/dwarika-venture/', '/dwarika-venture/sell-your-property/'] },
  { vid: 'hs-4-towers', w: 1280, hrefs: ['/about/', '/contact/#enquire'] },
];
const slides = media.map((s, i) => ({
  ...s, ...h.slides[i],
  btns: h.slides[i].btns.map((bt, k) => ({ t: bt, href: s.hrefs[k], gold: k === 0 })),
}));
---
<Base
  title={h.title}
  description={h.description}
  pageName={h.pageName}
>
  <!-- 1 · Hero: rotating slider -->
  <section class="hero hero-home" aria-roledescription="carousel" aria-label="SINTEL Enterprises" data-hero-slider>
    <div class="hero-media">
      <div class="stage">
        {slides.map((sl, i) => (
          <div class:list={['hs-media', { 'is-active': i === 0 }]} data-i={i}>
            <img class="poster" src={m(`img/${sl.vid}-poster.webp`)} srcset={`${m(`img/${sl.vid}-poster-m.webp`)} 960w, ${m(`img/${sl.vid}-poster.webp`)} ${sl.w}w`} sizes="100vw" alt="" width={sl.w} height={sl.w * 9 / 16} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
            <video muted playsinline preload="none" aria-hidden="true" data-src={m(`video/${sl.vid}.mp4`)} data-src-m={m(`video/${sl.vid}-m.mp4`)}></video>
            {i === 0 && <>
              <a class="island-tag" href={u('/dwarika-finserv/')} style="left:17%;top:40%;--tilt:-8deg">Dwarika Finserv<span class="pulse"></span></a>
              <a class="island-tag" href={u('/dwarika-venture/')} style="left:84%;top:40%;--tilt:8deg">Dwarika Venture<span class="pulse"></span></a>
            </>}
          </div>
        ))}
      </div>
      <div class="hs-shimmer" aria-hidden="true"></div>
    </div>
    <div class="wrap hero-content">
      {slides.map((sl, i) => (
        <div class:list={['hs-copy', { 'is-active': i === 0 }]} data-i={i} role="group" aria-roledescription="slide" aria-label={h.slideOf(i + 1, slides.length)} inert={i !== 0}>
          <div>
            <p class="eyebrow" data-hero-in={i === 0 ? '' : undefined}>{sl.eyebrow}</p>
            {i === 0
              ? <h1><span class="line"><span>{sl.t1}</span></span> <span class="line"><span><em>{sl.t2}</em></span></span></h1>
              : <h2 class="hs-h"><span class="line"><span>{sl.t1}</span></span> <span class="line"><span><em>{sl.t2}</em></span></span></h2>}
          </div>
          <div class="btns" data-hero-in={i === 0 ? '' : undefined}>
            {sl.btns.map((bt) => (
              <a class:list={['btn', 'magnetic', { 'btn-gold': bt.gold }]} href={u(bt.href)}>{bt.t} <Icon name="arrow" class="chev arr" /></a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="hs-ctrl">
      <button class="hs-pause" type="button" aria-label={t.client.pause} aria-pressed="false"><span></span></button>
      {slides.map((sl, i) => (
        <button class:list={['hs-dot', { 'is-active': i === 0 }]} type="button" data-go={i} aria-label={h.slideLabel(i + 1, `${sl.t1} ${sl.t2}`)} aria-current={i === 0 ? 'true' : undefined}><i></i></button>
      ))}
    </div>
    <div class="scroll-cue" aria-hidden="true">{t.common.scroll}<i></i></div>
  </section>

  <!-- 2 · Statement -->
  <section class="section dark deep">
    <div class="dust" aria-hidden="true">
      {Array.from({ length: 22 }).map((_, i) => <i style={`left:${(i * 37) % 100}%;animation-duration:${9 + (i % 7) * 2}s;animation-delay:${(i * 1.3) % 9}s`} />)}
    </div>
    <div class="wrap">
      <p class="eyebrow">{h.whoWeAre}</p>
      <p class="statement" data-words set:html={statement} />
    </div>
  </section>

  <!-- 3 · Our companies -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">{h.companies}</p>
        <h2 data-split>{h.companiesH[0]} <em>{h.companiesH[1]}</em></h2>
      </div>
      <div class="co-grid">
        <a class="co-card" href={u('/dwarika-finserv/')} data-tilt data-morph data-reveal>
          <img src={m('img/img-02-finance-island.webp')} srcset={`${m('img/img-02-finance-island-m.webp')} 560w, ${m('img/img-02-finance-island.webp')} 896w`} sizes="(max-width: 760px) 92vw, 46vw" alt={h.finAlt} loading="lazy" width="896" height="1200" transition:name="hero-finserv" />
          <div class="ov">
            <p class="eyebrow">{h.finEyebrow}</p>
            <h3>Dwarika Finserv</h3>
            <p>{h.finText}</p>
            <span class="link-arrow">{t.common.explore} <Icon name="arrow" class="chev arr" /></span>
          </div>
        </a>
        <a class="co-card" href={u('/dwarika-venture/')} data-tilt data-morph data-reveal>
          <img src={m('img/img-03-property-island.webp')} srcset={`${m('img/img-03-property-island-m.webp')} 560w, ${m('img/img-03-property-island.webp')} 896w`} sizes="(max-width: 760px) 92vw, 46vw" alt={h.venAlt} loading="lazy" width="896" height="1200" transition:name="hero-venture" />
          <div class="ov">
            <p class="eyebrow">{h.venEyebrow}</p>
            <h3>Dwarika Venture</h3>
            <p>{h.venText}</p>
            <span class="link-arrow">{t.common.explore} <Icon name="arrow" class="chev arr" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4 · Loans list -->
  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Dwarika Finserv</p>
        <h2 data-split>{h.loansH[0]} <em>{h.loansH[1]}</em></h2>
      </div>
      <HoverList items={loans.map((l) => ({ href: lp(lang, `/dwarika-finserv/${l.slug}/`), title: l.name, desc: l.oneLiner, img: l.img }))} />
    </div>
  </section>

  <!-- 5 · Featured properties -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Dwarika Venture</p>
        <h2 data-split>{h.propsH[0]} <em>{h.propsH[1]}</em></h2>
      </div>
      {featured.length > 0 ? (
        <>
          <div class="prop-grid">{featured.map((p) => <PropertyCard p={p} />)}</div>
          <div class="btns mt-3"><a class="btn btn-green magnetic" href={u('/dwarika-venture/')}>{h.viewAll} <Icon name="arrow" class="chev arr" /></a></div>
        </>
      ) : (
        <>
          <p class="lead muted" style="max-width:46ch">{h.propsLead}</p>
          <div class="btns mt-2">
            <a class="btn btn-green magnetic" href={u('/dwarika-venture/')}>{h.exploreVenture} <Icon name="arrow" class="chev arr" /></a>
            <a class="btn btn-line-dk" href={waLink(h.waProp, 'venture')} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> {h.askWa}</a>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- 6 · How it works -->
  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">{t.common.howItWorks}</p>
        <h2 data-split>{h.stepsH[0]} <em>{h.stepsH[1]}</em></h2>
      </div>
      <Steps steps={h.steps} />
    </div>
  </section>

  <!-- 7 · Why SINTEL -->
  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <h2 data-split>{h.whyH[0]} <em>{h.whyH[1]}</em></h2>
      </div>
      <div class="cards">
        {why.map((w) => (
          <div class="card" data-reveal>
            <span class="icon"><Icon name={w.icon} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7b · Track record -->
  <TrackRecord />

  <Reviews />

  <!-- 8 · Enquiry -->
  <Enquiry img="img-04-sintel-towers" />
</Base>
