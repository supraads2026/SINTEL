---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import HoverList from '../../../components/HoverList.astro';
import Steps from '../../../components/Steps.astro';
import Enquiry from '../../../components/Enquiry.astro';
import PropertyCard from '../../../components/PropertyCard.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import { m } from '../../../lib/url';
import { properties } from '../../../data/property';
import { site, waLink, postalAddress } from '../../../data/site';
import { langPaths, lp, lu, useT, type Lang } from '../../../i18n';
import { propertyTypesFor } from '../../../i18n/data';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const v = t.venture;
const u = (p: string) => lu(lang, p);
const propertyTypes = propertyTypesFor(lang);

const whyIcons = ['shield', 'eye', 'key', 'handshake'];
const why = v.whyList.map((w, i) => ({ icon: whyIcons[i], ...w }));
const guideCards = [
  { icon: 'doc', h: '#documents' },
  { icon: 'shield', h: '#orera' },
  { icon: 'compass', h: '#registration' },
].map((c, i) => ({ ...c, ...v.guideCards[i] }));
const schema = [{ '@context': 'https://schema.org', '@type': 'RealEstateAgent', name: site.venture, parentOrganization: site.legalName, areaServed: 'Bhubaneswar, Odisha', address: postalAddress, url: new URL(Astro.url.pathname, Astro.site).href, telephone: site.venturePhone.replace(/\s/g, ''),
  ...(site.oreraAgent ? { identifier: { '@type': 'PropertyValue', propertyID: 'ORERA real estate agent registration', value: site.oreraAgent } } : {}) }];
---
<Base title={v.title} description={v.description} pageName="Dwarika Venture" schema={schema}>
  <section class="hero" aria-label="Dwarika Venture">
    <div class="hero-media">
      <div class="stage">
        <img class="poster" src={m('img/vid-05-venture-hero-poster.webp')} srcset={`${m('img/vid-05-venture-hero-poster-m.webp')} 960w, ${m('img/vid-05-venture-hero-poster.webp')} 1280w`} sizes="100vw" alt="" width="1280" height="720" fetchpriority="high" transition:name="hero-venture" />
        <video data-hero-video muted playsinline loop preload="none" poster={m('img/vid-05-venture-hero-poster.webp')} aria-hidden="true"><source src={m('video/vid-05-venture-hero-m.mp4')} type="video/mp4" media="(max-width: 900px)" /><source src={m('video/vid-05-venture-hero.mp4')} type="video/mp4" /></video>
      </div>
    </div>
    <div class="wrap hero-content">
      <p class="eyebrow" data-hero-in>Dwarika Venture</p>
      <h1><span class="line"><span>{v.h1[0]}</span></span><span class="line"><span><em>{v.h1[1]}</em></span></span></h1>
      <p class="lead" data-hero-in>{v.lead}</p>
      <div class="btns" data-hero-in>
        <a class="btn btn-gold magnetic" href="#listings">{properties.length ? v.exploreProps : v.findProp} <Icon name="arrow" class="chev arr" /></a>
        <a class="btn magnetic" href={u('/dwarika-venture/sell-your-property/')}>{v.sell} <Icon name="arrow" class="chev arr" /></a>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true">{t.common.scroll}<i></i></div>
  </section>

  <section class="section dark deep">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{v.types}</p><h2 data-split>{v.typesH[0]} <em>{v.typesH[1]}</em></h2></div>
      <HoverList items={propertyTypes.map((p) => ({ href: lp(lang, `/dwarika-venture/${p.slug}/`), title: p.name, desc: p.oneLiner, img: p.img }))} />
    </div>
  </section>

  <section class="section ivory" id="listings">
    <div class="wrap">
      {properties.length > 0 ? (
        <>
          <div class="sec-head"><p class="eyebrow">{v.featured}</p><h2 data-split>{v.marketH[0]} <em>{v.marketH[1]}</em></h2></div>
          <div class="chips" data-filters="#all-props" style="margin-bottom:32px">
            <button class="chip" data-k="all" aria-pressed="true">{v.all}</button>
            {propertyTypes.map((p) => <button class="chip" data-k={p.key} aria-pressed="false">{v.chip(p.name)}</button>)}
          </div>
          <div class="prop-grid" id="all-props">{properties.map((p) => <PropertyCard p={p} />)}</div>
        </>
      ) : (
        <div class="two-col" style="align-items:center">
          <div class="sec-head" style="margin:0"><p class="eyebrow">{v.props}</p><h2 data-split>{v.needH[0]} <em>{v.needH[1]}</em></h2></div>
          <div>
            <p class="lead muted">{v.needLead}</p>
            <div class="btns mt-2">
              <a class="btn btn-green magnetic" href="#enquire">{v.sendReq} <Icon name="arrow" class="chev arr" /></a>
              <a class="btn btn-line-dk" href={waLink(v.waNeed, 'venture')} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> {t.common.whatsapp}</a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section dark">
    <div class="wrap two-col">
      <div>
        <div class="sec-head"><p class="eyebrow">{v.why}</p><h2 data-split>{v.whyH[0]} <em>{v.whyH[1]}</em></h2></div>
        <img src={m('img/img-06-plot-map-sm.webp')} alt={v.plotAlt} loading="lazy" width="720" height="402" style="border-radius:22px;height:auto" data-parallax />
      </div>
      <div class="cards cards-2">
        {why.map((w) => <div class="card" data-reveal><span class="icon"><Icon name={w.icon} /></span><h3>{w.t}</h3><p set:html={w.d.replace(/TODO\(SINTEL\):\s*(.+)$/, '<mark class="todo">$1</mark>')} /></div>)}
      </div>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{v.process}</p><h2 data-split>{v.processH[0]} <em>{v.processH[1]}</em></h2></div>
      <Steps steps={v.steps} />
    </div>
  </section>

  <section class="section dark deep">
    <div class="wrap two-col" style="align-items:center">
      <div>
        <p class="eyebrow">{v.owners}</p>
        <h2 data-split>{v.ownersH[0]} <em>{v.ownersH[1]}</em></h2>
        <p class="lead muted mt-2">{v.ownersLead}</p>
        <div class="btns mt-2"><a class="btn btn-gold magnetic" href={u('/dwarika-venture/sell-your-property/')}>{v.sell} <Icon name="arrow" class="chev arr" /></a></div>
      </div>
      <img src={m('img/img-v5-sell-property-sm.webp')} alt={v.keyAlt} loading="lazy" width="720" height="720" style="border-radius:26px;width:min(420px,100%);justify-self:center" class="floaty" />
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{v.guide}</p><h2 data-split>{v.guideH[0]} <em>{v.guideH[1]}</em></h2></div>
      <div class="cards">
        {guideCards.map((c) => <a class="card" style="text-decoration:none" href={u(`/dwarika-venture/buyers-guide/${c.h}`)} data-reveal><span class="icon"><Icon name={c.icon} /></span><h3>{c.t}</h3><p>{c.d}</p></a>)}
      </div>
      <div class="btns mt-3"><a class="btn btn-green magnetic" href={u('/dwarika-venture/buyers-guide/')}>{v.readGuide} <Icon name="arrow" class="chev arr" /></a></div>
    </div>
  </section>

  <Enquiry interest="venture" title={v.enquiryH} />
  <Disclaimer kind="venture" />
</Base>
