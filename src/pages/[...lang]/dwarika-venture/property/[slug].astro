---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import PropertyCard from '../../../../components/PropertyCard.astro';
import Enquiry from '../../../../components/Enquiry.astro';
import Disclaimer from '../../../../components/Disclaimer.astro';
import { m } from '../../../../lib/url';
import { waLink } from '../../../../data/site';
import { properties, type Property } from '../../../../data/property';
import { langPaths, lu, useT, type Lang } from '../../../../i18n';
import { typeByKeyFor } from '../../../../i18n/data';

// Listings are shown as entered in property.ts (title, location, area, price); the page around them is translated.
export function getStaticPaths() {
  return langPaths().flatMap(({ params, props }) =>
    properties.map((p) => ({ params: { ...params, slug: p.slug }, props: { ...props, p } })));
}
const { lang, p } = Astro.props as { lang: Lang; p: Property };
const tr = useT(lang);
const pr = tr.property;
const u = (path: string) => lu(lang, path);
const t = typeByKeyFor(lang, p.type);
const similar = properties.filter((x) => x.slug !== p.slug && x.type === p.type).concat(properties.filter((x) => x.type !== p.type)).slice(0, 3);
---
<Base title={pr.title(p.title, p.location)} description={pr.description(p.title, p.location, p.area, p.price)} pageName={p.title} image={p.photos[0]} noindex={p.sample}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label={tr.common.breadcrumb}><a href={u('/')}>{tr.common.home}</a><span>/</span><a href={u('/dwarika-venture/')}>Dwarika Venture</a><span>/</span><a href={u(`/dwarika-venture/${t.slug}/`)}>{t.name}</a></nav>
      <p class="eyebrow" data-hero-in>{t.name}{p.sample && pr.sampleListing}</p>
      <h1><span class="line"><span>{p.title}</span></span><span class="line"><span><em>{p.location}</em></span></span></h1>
    </div>
  </section>
  <section class="section ivory" style="padding-top:60px">
    <div class="wrap two-col">
      <div>
        <div class="gallery">{p.photos.map((ph) => <img src={m(ph)} alt={p.title} width="1024" height="640" />)}</div>
        {p.photos.length > 1 && <p class="muted" style="margin-top:10px;font-size:.85rem">{pr.swipe}</p>}
      </div>
      <div>
        <div class="facts">
          <div><span>{pr.type}</span><b>{t.name}</b></div>
          <div><span>{pr.area}</span><b>{p.area}</b></div>
          <div><span>{pr.price}</span><b>{p.price}</b></div>
          <div><span>ORERA</span><b>{p.orera ?? '—'}</b></div>
        </div>
        <h3 class="mt-3" style="margin-bottom:1rem">{pr.highlights}</h3>
        <ul class="check-list">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        <div class="btns mt-2">
          <a class="btn btn-green magnetic" href="#enquire">{tr.common.enquire} <Icon name="arrow" class="chev arr" /></a>
          <a class="btn btn-line-dk" href={waLink(tr.propertyCard.waInterested(p.title, p.location), 'venture')} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> {tr.common.whatsapp}</a>
        </div>
        <p class="mt-2"><a class="link-arrow" href={u('/dwarika-finserv/home-loan/')}>{pr.needLoan} <Icon name="arrow" class="chev arr" /></a></p>
      </div>
    </div>
  </section>
  {p.mapQuery && (
    <section class="section ivory" style="padding-top:0"><div class="wrap">
      <div class="map-load" data-map={p.mapQuery}><button class="btn btn-gold" type="button">{pr.showMap}</button></div>
    </div></section>
  )}
  {similar.length > 0 && (
    <section class="section ivory" style="padding-top:0"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">{pr.similar}</p><h2 data-split>{pr.similarH[0]} <em>{pr.similarH[1]}</em></h2></div>
      <div class="prop-grid">{similar.map((s) => <PropertyCard p={s} />)}</div>
    </div></section>
  )}
  <Enquiry interest="venture" need={`Property: ${p.title} (${p.location})`} title={pr.enquiryH} />
  <Disclaimer kind="venture" />
</Base>
