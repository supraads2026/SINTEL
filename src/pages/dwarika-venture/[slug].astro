---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Enquiry from '../../components/Enquiry.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { u } from '../../lib/url';
import { propertyTypes, properties, type PropertyType } from '../../data/property';

export function getStaticPaths() {
  return propertyTypes.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: PropertyType };
const list = properties.filter((p) => p.type === t.key);
const others = propertyTypes.filter((o) => o.key !== t.key);
---
<Base title={`${t.name} for Sale in Bhubaneswar | Dwarika Venture`} description={t.description} pageName={t.name} image={`img/${t.img}.webp`}>
  <PageHero eyebrow="Dwarika Venture" h1={t.h1} lead={t.oneLiner} img={t.img} crumbs={[{ href: '/dwarika-venture/', name: 'Dwarika Venture' }]}>
    <div class="btns">
      <a class="btn btn-gold magnetic" href="#listings">See listings <Icon name="arrow" class="chev arr" /></a>
      <a class="btn" href="#enquire">Tell us your need</a>
    </div>
  </PageHero>

  <section class="section ivory" id="listings">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Listings</p><h2 data-split>{t.name}</h2><p class="lead muted">{t.intro}</p></div>
      {list.length > 0
        ? <div class="prop-grid">{list.map((p) => <PropertyCard p={p} />)}</div>
        : <p class="empty">New listings coming soon. Tell us what you're looking for and we'll call you when something fits.</p>}
    </div>
  </section>

  <section class="section dark">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">Before you buy</p><h2 data-split>What to <em>look for.</em></h2></div>
      <ul class="check-list">{t.lookFor.map((x) => <li data-reveal>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">FAQs</p><h2 data-split>Good <em>questions.</em></h2></div>
      <Faq faqs={t.faqs} />
    </div>
  </section>

  <section class="section green">
    <div class="wrap two-col" style="align-items:center">
      <div><p class="eyebrow">Dwarika Finserv</p><h2 data-split>Need a <em>home loan?</em></h2></div>
      <div><p class="lead">Our sister company helps you compare home-loan and property-loan options, so the funding is ready when you find the right place.</p>
        <a class="btn btn-gold magnetic mt-2" href={u('/dwarika-finserv/home-loan/')}>Explore home loans <Icon name="arrow" class="chev arr" /></a></div>
    </div>
  </section>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Other property types</p><h2 data-split>Keep <em>exploring.</em></h2></div>
      <Related items={others.map((o) => ({ href: `/dwarika-venture/${o.slug}/`, title: o.name, desc: o.oneLiner, img: o.img }))} />
    </div>
  </section>

  <Enquiry interest="venture" need={`Buy: ${t.name}`} title={['Looking for', `${t.name.toLowerCase()}?`]} />
  <Disclaimer kind="venture" />
</Base>
