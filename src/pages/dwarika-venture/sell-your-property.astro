---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { site } from '../../data/site';
import { propertyTypes } from '../../data/property';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Dwarika Venture, I want to sell my property.')}`;
---
<Base title="Sell Your Property in Bhubaneswar | Dwarika Venture" description="List your flat, house, plot or commercial space with Dwarika Venture. We market it to genuine buyers and assist you till registration." pageName="Sell Your Property" image="img/img-v5-sell-property.webp">
  <PageHero eyebrow="Dwarika Venture · For owners" h1={['Sell with', 'confidence.']} lead="List your flat, house, plot or commercial space with Dwarika Venture." img="img-v5-sell-property" crumbs={[{ href: '/dwarika-venture/', name: 'Dwarika Venture' }]}>
    <div class="btns">
      <a class="btn btn-gold magnetic" href="#enquire">List your property <Icon name="arrow" class="chev arr" /></a>
      <a class="btn" href={wa} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> WhatsApp</a>
    </div>
  </PageHero>

  <section class="section ivory">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">How it works</p><h2 data-split>Simple, <em>start to finish.</em></h2></div>
      <Steps steps={[
        { t: 'Share details', d: 'Tell us about the property and send a few photos.' },
        { t: 'Price discussion', d: 'We discuss a realistic asking price with you.' },
        { t: 'We market it', d: 'We bring the property to genuine, interested buyers.' },
        { t: 'Till registration', d: 'We assist you through the sale and registration.' },
      ]} />
      <p class="mt-3"><mark class="todo">To confirm: is the valuation / price discussion free for owners?</mark></p>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap two-col">
      <div class="sec-head"><p class="eyebrow">What we need</p><h2 data-split>Keep these <em>ready.</em></h2></div>
      <ul class="check-list">
        {['Ownership documents (title deed, RoR / mutation)', 'Clear photos of the property', 'Exact location', 'Area (carpet / built-up / plot)', 'Your expected price'].map((x) => <li data-reveal>{x}</li>)}
      </ul>
    </div>
  </section>

  <section class="section green" id="enquire">
    <div class="wrap enquiry">
      <div>
        <p class="eyebrow">Owner form</p>
        <h2><span class="line"><span>List your</span></span><span class="line"><span><em>property.</em></span></span></h2>
        <p class="lead mt-2" style="color:rgba(252,251,246,.92)">Share the basics and we'll call you back. You can also send photos on WhatsApp.</p>
        <div class="btns mt-2"><a class="btn" href={wa} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> WhatsApp us</a></div>
      </div>
      <form class="form" data-enquiry novalidate>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New owner listing — Dwarika Venture" />
        <input type="hidden" name="interested_in" value="Dwarika Venture (property)" />
        <input type="hidden" name="need" value="Sell my property" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
        <div class="field"><label for="s-name">Name</label><input id="s-name" name="name" required autocomplete="name" /></div>
        <div class="field"><label for="s-mobile">Mobile</label><input id="s-mobile" name="mobile" required type="tel" inputmode="tel" autocomplete="tel" /></div>
        <div class="field"><label for="s-type">Property type</label><select id="s-type" name="property_type" required><option value="" disabled selected>Choose one</option>{propertyTypes.map((t) => <option>{t.name}</option>)}</select></div>
        <div class="field"><label for="s-loc">Location</label><input id="s-loc" name="location" required placeholder="Area, city" /></div>
        <div class="field"><label for="s-area">Area</label><input id="s-area" name="area" placeholder="e.g. 1,200 sq ft" /></div>
        <div class="field"><label for="s-price">Expected price</label><input id="s-price" name="expected_price" placeholder="e.g. ₹ 60 Lakh" /></div>
        <div class="field full"><label for="s-photo">Photo link (optional)</label><input id="s-photo" name="photo_link" type="url" placeholder="Google Drive / Photos link" /></div>
        <div class="field full"><label for="s-msg">Anything else</label><textarea id="s-msg" name="message" rows="3"></textarea></div>
        <label class="consent full"><input type="checkbox" name="consent" required /> <span>I agree to be contacted by Dwarika Venture about listing my property.</span></label>
        <div class="btns full">
          <button class="btn btn-gold magnetic" type="submit">Send details <Icon name="arrow" class="chev arr" /></button>
          <button class="btn" type="button" data-wa-send><Icon name="wa" class="chev" /> Send on WhatsApp</button>
        </div>
        <p class="form-status full" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
  <Disclaimer kind="venture" />
</Base>
