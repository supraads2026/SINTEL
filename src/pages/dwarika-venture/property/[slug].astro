---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PropertyCard from '../../../components/PropertyCard.astro';
import Enquiry from '../../../components/Enquiry.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import { m, u } from '../../../lib/url';
import { waLink } from '../../../data/site';
import { properties, typeByKey, type Property } from '../../../data/property';

export function getStaticPaths() {
  return properties.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Property };
const t = typeByKey(p.type);
const similar = properties.filter((x) => x.slug !== p.slug && x.type === p.type).concat(properties.filter((x) => x.type !== p.type)).slice(0, 3);
---
<Base title={`${p.title}, ${p.location} | Dwarika Venture`} description={`${p.title} for sale in ${p.location}. ${p.area}. ${p.price}. Enquire with Dwarika Venture.`} pageName={p.title} image={p.photos[0]} noindex={p.sample}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={u('/')}>Home</a><span>/</span><a href={u('/dwarika-venture/')}>Dwarika Venture</a><span>/</span><a href={u(`/dwarika-venture/${t.slug}/`)}>{t.name}</a></nav>
      <p class="eyebrow" data-hero-in>{t.name}{p.sample && ' · Sample listing'}</p>
      <h1><span class="line"><span>{p.title}</span></span><span class="line"><span><em>{p.location}</em></span></span></h1>
    </div>
  </section>
  <section class="section ivory" style="padding-top:60px">
    <div class="wrap two-col">
      <div>
        <div class="gallery">{p.photos.map((ph) => <img src={m(ph)} alt={p.title} width="1024" height="640" />)}</div>
        {p.photos.length > 1 && <p class="muted" style="margin-top:10px;font-size:.85rem">Swipe for more photos</p>}
      </div>
      <div>
        <div class="facts">
          <div><span>Type</span><b>{t.name}</b></div>
          <div><span>Area</span><b>{p.area}</b></div>
          <div><span>Price</span><b>{p.price}</b></div>
          <div><span>ORERA</span><b>{p.orera ?? '—'}</b></div>
        </div>
        <h3 class="mt-3" style="margin-bottom:1rem">Highlights</h3>
        <ul class="check-list">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        <div class="btns mt-2">
          <a class="btn btn-green magnetic" href="#enquire">Enquire <Icon name="arrow" class="chev arr" /></a>
          <a class="btn btn-line-dk" href={waLink(`Hi Dwarika Venture, I'm interested in ${p.title} (${p.location}).`)} target="_blank" rel="noopener"><Icon name="wa" class="chev" /> WhatsApp</a>
        </div>
        <p class="mt-2"><a class="link-arrow" href={u('/dwarika-finserv/home-loan/')}>Need a home loan? Dwarika Finserv <Icon name="arrow" class="chev arr" /></a></p>
      </div>
    </div>
  </section>
  {p.mapQuery && (
    <section class="section ivory" style="padding-top:0"><div class="wrap">
      <div class="map-load" data-map={p.mapQuery}><button class="btn btn-gold" type="button">Show on Google Maps</button></div>
    </div></section>
  )}
  {similar.length > 0 && (
    <section class="section ivory" style="padding-top:0"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Similar properties</p><h2 data-split>You may <em>also like.</em></h2></div>
      <div class="prop-grid">{similar.map((s) => <PropertyCard p={s} />)}</div>
    </div></section>
  )}
  <Enquiry interest="venture" need={`Property: ${p.title} (${p.location})`} title={['Interested in', 'this property?']} />
  <Disclaimer kind="venture" />
</Base>
